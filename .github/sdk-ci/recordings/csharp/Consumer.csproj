    <TargetFramework Condition="'$(REACON_DOTNET_TFM)' != ''">$(REACON_DOTNET_TFM)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Reacon.Sdk" Version="$(REACON_SDK_PACKAGE_VERSION)" />
  </ItemGroup>
</Project>
